# Copy this file to .env and fill in real values. Never commit .env.
# .env is already gitignored; .env.example is the tracked template.

ANTHROPIC_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional overrides (see netlify/functions/claude.js) — safe to leave unset,
# each falls back to a sane default:
#
# The two model overrides point the Protocol Builder and the Meal Planner at a
# stronger model. Everything else (chat, photo_scan, recipe_scale) stays on
# Haiku by policy. Measured 2026-09-20: pointing protocol at Sonnet with the
# full corpus in context costs ~10.8x per uncached call. See
# manuscript/OVERNIGHT_REPORT_3.md before turning these on in production.
# ANTHROPIC_PROTOCOL_MODEL=
# ANTHROPIC_MEAL_PLAN_MODEL=
# PHOTO_SCAN_LIMIT_BASE=
# PHOTO_SCAN_LIMIT_PREMIUM=
# CHAT_MESSAGE_LIMIT=
# HARD_CAP_PER_24H_BASE=
# HARD_CAP_PER_24H_PREMIUM=
