# Force these as binary, no line-ending conversion, regardless of git's
# own (usually-correct-but-not-guaranteed) content-based auto-detection.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Finished course delivered as a zip: store every byte exactly as supplied,
# with no line-ending conversion, so a checkout anywhere matches the zip.
courses/autoimmune-elimination/** -text
